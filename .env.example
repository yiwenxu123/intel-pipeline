# Intel Pipeline 配置
# 复制为 .env 并填入实际值

# LLM 配置（小米 MiMo）
INTEL_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
INTEL_LLM_API_KEY=your-api-key-here
INTEL_LLM_PRE_FILTER_MODEL=mimo-v2.5-pro
INTEL_LLM_SCORING_MODEL=mimo-v2.5-pro

# 当前领域
INTEL_DOMAIN=elderly-care

# API 服务
INTEL_API_HOST=127.0.0.1
INTEL_API_PORT=8900

# 新鲜度过滤（天数）
INTEL_FRESHNESS_DAYS=3

# LLM 筛选窗口（只对最近 N 天的未评分条目跑 LLM）
INTEL_SCORE_WINDOW_DAYS=3

# 推送通知（飞书/企业微信 Webhook URL，留空不推送）
INTEL_NOTIFY_WEBHOOK=

# 管道告警：采集失败信源数 ≥ 此值时推送（独立于日报）
INTEL_PIPE_ALERT_ERROR_THRESHOLD=3

# 待评分堆积告警阈值（Dashboard 标红 + 可选飞书推送）
INTEL_UNSCORED_WARN_THRESHOLD=100

# 规则预筛（默认开启，零 LLM 成本；被拒条目 score=0 入库清积压）
INTEL_RULE_PREFILTER_ENABLED=true

# LLM 预筛已废弃，保留兼容
INTEL_PRE_FILTER_BACKLOG_THRESHOLD=999999

# LLM 成本估算（元/百万 tokens）
INTEL_LLM_COST_PER_1M_INPUT=2.0
INTEL_LLM_COST_PER_1M_OUTPUT=8.0

# 暂停自动采集的领域（逗号分隔；手动 CLI 仍可用，scheduler/start.sh 会跳过）
# 默认 china-africa 已暂停；恢复时留空或删除该行
INTEL_PAUSED_DOMAINS=china-africa

# 情报质量：评分前正文补全与简报提炼
INTEL_ENRICH_MIN_CONTENT_LENGTH=200
INTEL_SCORE_INPUT_MAX_CHARS=3000
INTEL_LOW_INPUT_THRESHOLD=80
INTEL_LOW_INPUT_MAX_SCORE=6.5
INTEL_BRIEFING_ENABLED=true

# API 写操作 Token（反馈/信源禁用等 POST；留空则不校验）
INTEL_API_TOKEN=
