# Intel Pipeline 配置
# 复制为 .env 并填入实际值

# LLM 配置（小米 MiMo）
INTEL_LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
INTEL_LLM_API_KEY=your-api-key-here
INTEL_LLM_PRE_FILTER_MODEL=mimo-v2.5-pro
INTEL_LLM_SCORING_MODEL=mimo-v2.5-pro

# 当前领域
INTEL_DOMAIN=elderly-care

# API 服务
INTEL_API_HOST=127.0.0.1
INTEL_API_PORT=8900

# 新鲜度过滤（天数）
INTEL_FRESHNESS_DAYS=3

# LLM 筛选窗口（只对最近 N 天的未评分条目跑 LLM）
INTEL_SCORE_WINDOW_DAYS=3

# 推送通知（飞书/企业微信 Webhook URL，留空不推送）
INTEL_NOTIFY_WEBHOOK=
